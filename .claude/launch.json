{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "port": 3000
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "BROWSER=none npm start"
      ],
      "port": 3009,
      "autoPort": true
    },
    {
      "name": "depth-mock",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "-s",
        "public",
        "-l",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "category-mock",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "-s",
        ".",
        "-l",
        "4322"
      ],
      "port": 4322
    },
    {
      "name": "wireframes",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "public",
        "-p",
        "4500"
      ],
      "port": 4500
    }
  ]
}